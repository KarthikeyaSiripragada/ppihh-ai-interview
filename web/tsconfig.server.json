{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/servers.ts",
    "src/application.ts",
    "src/interviewee.ts",
    "src/interviewers.ts",
    "src/interviews.ts",
    "src/auth.ts",
    "src/db.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/types.d.ts"
  ]
}
