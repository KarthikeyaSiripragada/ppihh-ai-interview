{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.server.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "lib/*": ["src/lib/*"]
